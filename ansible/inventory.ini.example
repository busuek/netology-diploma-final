[all:vars]
ansible_user=ubuntu
ansible_ssh_common_args='-o ProxyJump=ubuntu@<BASTION_IP> -o StrictHostKeyChecking=no'

[web]
web1 ansible_host=web1.ru-central1.internal
web2 ansible_host=web2.ru-central1.internal

[elasticsearch]
elastic ansible_host=elasticsearch.ru-central1.internal

[kibana]
kibana ansible_host=kibana.ru-central1.internal

[zabbix]
zabbix ansible_host=zabbix.ru-central1.internal
